{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vitest/globals"],
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "paths": {
      "electron-builder": ["./scripts/electron-builder.d.ts"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "renderer/md-mini.ts",
    "renderer/changelog-view.ts"
  ]
}
