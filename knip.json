{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/preload.ts",
    "renderer/*.ts",
    "scripts/*.ts",
    "tests/**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts",
    "renderer/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "ignoreBinaries": ["tail", "dpkg-deb", "tasklist", "pgrep", "pkill"],
  "ignoreDependencies": [
    "@types/debug",
    "@types/electron-positioner",
    "@vitest/coverage-v8"
  ]
}
