{
  "name": "devbar",
  "version": "0.6.0",
  "description": "Menu bar service launcher for Mac (WAMP-style)",
  "main": "build/src/main.js",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "start": "pnpm run build && electron .",
    "fetch-electron": "node node_modules/electron/install.js",
    "pack": "pnpm run build && bash scripts/package-macos-app.sh",
    "dist:mac": "pnpm run build && bash scripts/build-macos-release.sh",
    "release:verify": "pnpm run build && bash scripts/verify-macos-release.sh",
    "release:mac": "pnpm run dist:mac && bash scripts/verify-macos-release.sh",
    "install-local": "bash scripts/install-local.sh",
    "logs": "tail -F \"$HOME/Library/Logs/DevBar/app.log\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "deps:check": "depcruise src renderer scripts --config .dependency-cruiser.json --ts-config tsconfig.node.json",
    "quality": "pnpm typecheck && pnpm lint:strict && pnpm deadcode && pnpm deps:check && pnpm test",
    "postinstall": "node --experimental-strip-types scripts/install-hooks.ts",
    "build": "bash scripts/build.sh",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:preload && pnpm typecheck:renderer && pnpm typecheck:tests",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit"
  },
  "devDependencies": {
    "@electron/packager": "20.0.3",
    "@types/debug": "4.1.13",
    "@types/electron-positioner": "4.1.4",
    "@types/node": "22.20.1",
    "dependency-cruiser": "18.1.0",
    "electron": "43.2.0",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "jiti": "2.7.0",
    "knip": "6.29.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "electron-store": "11.0.2",
    "menubar": "9.5.2",
    "uuid": "14.0.1"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.5",
      "js-yaml": "4.3.0",
      "nanoid": "3.3.18",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "@types/electron-positioner>electron": "43.2.0"
    },
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "type": "module"
}
