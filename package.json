{
  "name": "devbar",
  "version": "0.9.1",
  "description": "Menu bar service launcher for macOS, Windows and Linux",
  "main": "build/src/main.js",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "start": "pnpm run build && electron .",
    "fetch-electron": "node node_modules/electron/install.js",
    "pack": "pnpm run build && node --experimental-strip-types scripts/platform.ts pack",
    "dist": "pnpm run build && node --experimental-strip-types scripts/platform.ts dist",
    "dist:mac": "pnpm run build && node --experimental-strip-types scripts/platform.ts dist:mac",
    "release:verify": "pnpm run build && node --experimental-strip-types scripts/platform.ts verify",
    "release": "pnpm run dist && pnpm run release:verify",
    "release:mac": "pnpm run dist:mac && pnpm run release:verify",
    "verify": "pnpm run build && node --experimental-strip-types scripts/platform.ts verify",
    "install-local": "node --experimental-strip-types scripts/platform.ts install-local",
    "install-local:dev": "node --experimental-strip-types scripts/platform.ts install-local --dev",
    "logs": "node --experimental-strip-types scripts/logs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "deps:check": "depcruise src renderer scripts --config .dependency-cruiser.json --ts-config tsconfig.node.json",
    "quality": "pnpm typecheck && pnpm lint:strict && pnpm deadcode && pnpm deps:check && pnpm test",
    "postinstall": "node --experimental-strip-types scripts/install-hooks.ts",
    "build": "node --experimental-strip-types scripts/build.ts",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:preload && pnpm typecheck:renderer && pnpm typecheck:tests",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/debug": "4.1.13",
    "@types/electron-positioner": "4.1.4",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.5.0",
    "@vitest/coverage-v8": "5.0.0",
    "dependency-cruiser": "18.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.16.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "jiti": "2.7.0",
    "js-yaml": "4.3.2",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "electron-store": "11.0.2",
    "menubar": "9.5.3",
    "uuid": "14.0.2"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.9.12",
      "fast-uri": "3.1.7",
      "js-yaml": "4.3.2",
      "nanoid": "3.3.18",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "@types/electron-positioner>electron": "43.2.0"
    },
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "type": "module"
}
