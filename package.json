{
  "name": "devbar",
  "version": "0.4.3",
  "description": "Menu bar service launcher for Mac (WAMP-style)",
  "main": "src/main.js",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "start": "electron .",
    "fetch-electron": "node node_modules/electron/install.js",
    "pack": "bash scripts/package-macos-app.sh",
    "dist:mac": "bash scripts/build-macos-release.sh",
    "release:verify": "bash scripts/verify-macos-release.sh",
    "release:mac": "pnpm run dist:mac && pnpm run release:verify",
    "install-local": "bash scripts/install-local.sh",
    "logs": "tail -F \"$HOME/Library/Logs/DevBar/app.log\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "deps:check": "depcruise src renderer scripts --config .dependency-cruiser.cjs",
    "quality": "pnpm lint:strict && pnpm deadcode && pnpm deps:check && pnpm test",
    "postinstall": "node scripts/install-hooks.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@vitest/coverage-v8": "4.0.17",
    "dependency-cruiser": "17.3.6",
    "electron": "40.2.1",
    "eslint": "9.39.2",
    "eslint-plugin-security": "3.0.1",
    "globals": "16.5.0",
    "knip": "5.83.2",
    "lefthook": "2.1.1",
    "prettier": "3.8.2",
    "vitest": "4.0.17"
  }
}
