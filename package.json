{
  "name": "devbar",
  "version": "0.2.0",
  "description": "Menu bar service launcher for Mac (WAMP-style)",
  "main": "src/main.js",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "start": "electron .",
    "fetch-electron": "node node_modules/electron/install.js",
    "pack": "electron-packager . DevBar --platform=darwin --out=dist --overwrite --icon=assets/icon.icns",
    "dist:mac": "bash scripts/build-macos-release.sh",
    "install-local": "bash scripts/install-local.sh",
    "logs": "tail -F \"$HOME/Library/Logs/DevBar/app.log\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "deps:check": "depcruise src renderer scripts --config .dependency-cruiser.cjs",
    "quality": "pnpm lint:strict && pnpm deadcode && pnpm deps:check && pnpm test",
    "postinstall": "node scripts/install-hooks.js"
  },
  "devDependencies": {
    "@electron/packager": "20.0.3",
    "dependency-cruiser": "18.1.0",
    "electron": "43.2.0",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "knip": "6.29.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "electron-store": "11.0.2",
    "menubar": "9.5.2",
    "uuid": "14.0.1"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.4",
      "js-yaml": "4.3.0"
    },
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
